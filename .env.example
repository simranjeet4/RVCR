# ==============================================================================
# RVCR.tech - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local testing or populate these values in your
# production hosting dashboard (e.g. Vercel, Netlify, Node server).
# ==============================================================================

# Node Environment
NODE_ENV=production

# Canonical Domain URL (Must be https://rvcr.tech without trailing slash)
NEXT_PUBLIC_SITE_URL=https://rvcr.tech

# Contact Inquiries Email Notification Dispatcher
# Optional: If omitted, inquiries log safely to server output.
# If provided, inquiries dispatch via Resend API.
RESEND_API_KEY=re_123456789_abcdefg

# Recipient Email for Contact Submissions
CONTACT_RECIPIENT_EMAIL=info@gyatk.com

# Verified Sender Email Address (e.g. inquiries@rvcr.tech)
CONTACT_FROM_EMAIL="RVCR Inquiries <inquiries@rvcr.tech>"

# Staging Flag (Set to "true" on staging environments to automatically inject noindex headers)
IS_STAGING=false
